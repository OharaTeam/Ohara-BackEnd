# ========================================================
# OHARA BACK-END - MODELO DE VARIÁVEIS DE AMBIENTE (.env)
# ========================================================
# Copie este arquivo para ".env" e preencha os valores antes de iniciar:
# $ cp .env.example .env

# --- AMBIENTE E SERVIDOR ---
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001
BOT_URL=http://localhost:3001

# --- BANCO DE DADOS (POSTGRESQL & DOCKER COMPOSE) ---
DB_USER=ohara
DB_PASSWORD=docker
DB_NAME=ohara_db

# String de conexão do Prisma ORM:
# Localmente fora do Docker:
DATABASE_URL="postgresql://ohara:docker@localhost:5432/ohara_db?schema=public"
# Dentro da rede do Docker Compose (ohara-network):
# DATABASE_URL="postgresql://${DB_USER}:${DB_PASSWORD}@ohara-postgres:5432/${DB_NAME}?schema=public"

# --- AUTENTICAÇÃO JWT ---
JWT_SECRET=sua_chave_jwt_secreta_super_segura_aqui

# --- AUTENTICAÇÃO DISCORD OAUTH2 ---
# --- SOLICITE AS CREDENCIAIS PARA TESTES ---
DISCORD_CLIENT_ID=seu_discord_client_id
DISCORD_CLIENT_SECRET=seu_discord_client_secret
DISCORD_CALLBACK_URL=http://localhost:3000/auth/discord/callback

# --- CHAVES DE COMUNICAÇÃO INTERNA (M2M) ---
# Header "X-API-KEY" enviado pelo Bot do Discord
BOT_KEY=sua_chave_secreta_compartilhada_com_o_bot
# Header "X-SITE-KEY" enviado pelo Dashboard/Frontend
SITE_KEY=sua_chave_secreta_compartilhada_com_o_site

# --- INTEGRAÇÃO COM STEAM ---
# Obtenha em https://steamcommunity.com/dev/apikey
STEAM_API_KEY=sua_steam_api_key_aqui